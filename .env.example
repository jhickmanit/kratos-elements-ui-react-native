# Ory Configuration
# =================
# Set ONE of the following depending on your setup:

# Option 1: Ory Network (Cloud)
# Use your Ory Network project URL (found in Ory Console)
# Example: https://your-project.projects.oryapis.com
#EXPO_PUBLIC_ORY_PROJECT_URL=https://your-project.projects.oryapis.com

# Option 2: Self-hosted Kratos
# Use your local or self-hosted Kratos public API URL
# Example: http://localhost:4433 (default Kratos public API port)
# EXPO_PUBLIC_ORY_PROJECT_URL=http://localhost:4433

# Note: For local development with a physical device or emulator,
# use your machine's IP address instead of localhost:
EXPO_PUBLIC_ORY_PROJECT_URL=http://192.168.50.61:4433
